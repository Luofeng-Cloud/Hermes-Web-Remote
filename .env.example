# ==============================================================================
# Hermes Web Remote - 环境配置模板 (.env.example)
# ==============================================================================
# 首次运行《启动网站.bat》时会自动生成 .env 文件并赋予开箱即用的默认凭据。
# 若需自定义，复制本文件为 .env 或直接修改 .env 即可。

# [可选] Web 登录用户名 (默认为 hermes，或读取 Hermes config.yaml)
HERMES_WEB_USER=hermes

# [可选] Web 登录密码 (开箱默认密码为 hermes123，可随意在此修改)
HERMES_WEB_PASSWORD=hermes123

# [可选] Hermes 数据根目录 (默认自动探测系统标准路径: %LOCALAPPDATA%\hermes)
# HERMES_HOME=C:\Users\YourUsername\AppData\Local\hermes

# [可选] 服务监听端口 (默认 9220)
# PORT=9220
