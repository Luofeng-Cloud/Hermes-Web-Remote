# ==============================================================================
# Hermes Web Remote - 环境配置模板 (.env.example)
# ==============================================================================

# [可选] Hermes 数据根目录 (默认自动探测当前系统标准路径: %LOCALAPPDATA%\hermes)
# HERMES_HOME=C:\Users\YourUsername\AppData\Local\hermes

# [可选] Web 登录用户名 (默认优先读取 Hermes config.yaml 中的 basic_auth.username)
# HERMES_WEB_USER=hermes

# [可选] Web 登录密码 (若 Hermes 未设置 basic_auth 密码，可通过此项显式指定)
# HERMES_WEB_PASSWORD=your_secure_password_here

# [可选] 服务监听端口 (默认 9220)
# PORT=9220
