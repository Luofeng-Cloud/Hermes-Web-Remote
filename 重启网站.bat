@echo off
rem ============================================================================
rem  Hermes Web Remote - 智能重启脚本
rem ============================================================================
chcp 936 >nul
cd /d "%~dp0"

echo [1/2] 正在停止旧服务...
call "%~dp0停止网站.bat" >nul 2>&1
timeout /t 1 /nobreak >nul 2>&1 || ping -n 2 127.0.0.1 >nul

echo [2/2] 正在拉起新服务...
call "%~dp0启动网站.bat"
